# ===================================
# Server Configuration
# ===================================

# HTTP server port
PORT=7860

# Server listening host address (use 0.0.0.0 for all interfaces)
HOST=0.0.0.0

# WebSocket server port for internal browser communication
# ⚠️ DEPRECATED: This environment variable is no longer supported in the current version
# The WebSocket port is fixed at 9998. The ChangAn hardened entrypoint binds it to 127.0.0.1 only.
# WS_PORT=9998

# ===================================
# Authentication Configuration
# ===================================

# Web console username (optional)
WEB_CONSOLE_USERNAME=

# Web console password (optional)
WEB_CONSOLE_PASSWORD=

# API keys for authenticating client requests (comma-separated)
# REQUIRED in production by the ChangAn hardened entrypoint.
# Example: change-me-to-a-long-random-secret
API_KEYS=

# ===================================
# Security Configuration
# ===================================

SECURE_COOKIES=false
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
INITIAL_AUTH_INDEX=0

# Maximum accepted request body size in bytes.
# Default in the ChangAn hardened entrypoint: 67108864 (64 MiB)
MAX_REQUEST_BODY_BYTES=67108864

# Override the dedicated AI Studio Build App target when upstream changes it.
# Must remain an https://ai.studio/apps/... URL.
AISTUDIO_APP_URL=https://ai.studio/apps/cab9ab6c-44f9-4e7a-8972-037f8ae177ab

# ===================================
# UI Configuration
# ===================================

ICON_URL=
CHECK_UPDATE=true

# ===================================
# Logging Configuration
# ===================================

LOG_LEVEL=INFO
TZ=

# ===================================
# Browser Configuration
# ===================================

CAMOUFOX_EXECUTABLE_PATH=

# Higher values consume more memory (approx: 1 account ~700MB, 2 accounts ~950MB, 3 accounts ~1100MB)
MAX_CONTEXTS=1

# ===================================
# Request Handling Configuration
# ===================================

STREAMING_MODE=real
MAX_RETRIES=3
RETRY_DELAY=2000
STREAM_TIMEOUT_MS=60000
FAKE_STREAM_TIMEOUT_MS=300000
FORCE_THINKING=false
FORCE_WEB_SEARCH=false
FORCE_CODE_EXECUTION=false
FORCE_URL_CONTEXT=false
ENABLE_AUTH_UPDATE=true
ENABLE_USAGE_STATS=true

# ===================================
# Account Switching Configuration
# ===================================

# Preserved for multi-account deployments. When exactly one canonical Google account
# is configured, the ChangAn hardened entrypoint automatically ignores usage-count
# rotation so the same browser session is not pointlessly restarted every N requests.
SWITCH_ON_USES=40

# Generic repeated failures may still refresh/recover the only browser context.
FAILURE_THRESHOLD=3

# HTTP 429 is treated specially in single-account mode: the current browser context
# is preserved and Google's rate/quota error is returned instead of restarting it.
SAFETY_SETTINGS_THRESHOLD=OFF
IMMEDIATE_SWITCH_STATUS_CODES=429,503

# ===================================
# Proxy Configuration
# ===================================

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
